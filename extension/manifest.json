{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "i18n.js",
        "featureAccess.js",
        "config.js",
        "deepseekDOM.js",
        "storageService.js",
        "apiClient.js",
        "dialogUtils.js",
        "paywallModal.js",
        "folderService.js",
        "folderModal.js",
        "pinnedMessagesService.js",
        "pinnedMessagesModal.js",
        "pinnedMessages.js",
        "bulkDeleteModal.js",
        "chatExporter.js",
        "chatExportModal.js",
        "defaultPrompts.js",
        "promptLibraryService.js",
        "promptEditorModal.js",
        "promptChainService.js",
        "promptChainModal.js",
        "promptChainExecutor.js",
        "promptLibraryModal.js",
        "promptEnhancer.js",
        "content.js"
      ],
      "css": [
        "styles.css",
        "promptEnhancer.css",
        "paywallModal.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_16x16.png",
      "19": "icons/icon_19x19.png",
      "32": "icons/icon_32x32.png",
      "38": "icons/icon_38x38.png",
      "48": "icons/icon_48x48.png",
      "128": "icons/icon_128x128.png"
    }
  },
  "icons": {
    "16": "icons/icon_16x16.png",
    "32": "icons/icon_32x32.png",
    "48": "icons/icon_48x48.png",
    "64": "icons/icon_64x64.png",
    "128": "icons/icon_128x128.png",
    "256": "icons/icon_256x256.png",
    "512": "icons/icon_512x512.png"
  }
}
